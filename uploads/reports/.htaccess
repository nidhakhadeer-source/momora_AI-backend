# =============================================================================
# Momora AI - Protected Medical Reports Directory
# Direct access to patient medical reports is forbidden.
# All document access must pass through /reports/download.php with authentication.
# =============================================================================

<Files "*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
