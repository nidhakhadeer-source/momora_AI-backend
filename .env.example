# =============================================================================
# Momora AI - Backend Environment Configuration Template
# =============================================================================
# To configure: copy this file to .env and insert your real API keys.
# .env is ignored by Git and will never be committed.

# AI Provider: 'gemini' (recommended) or 'openai' or 'fallback'
AI_PROVIDER=gemini

# Google Gemini API Configuration (Get your free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
