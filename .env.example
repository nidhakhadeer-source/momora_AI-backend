# =============================================================================
# Momora AI - Backend Environment Configuration Template
# =============================================================================
# To configure: copy this file to .env and insert your real API keys.
# .env is ignored by Git and will never be committed.

# AI Provider: 'fastapi' (default local Ollama service), 'python', 'gemini', 'openai', or 'fallback'
AI_PROVIDER=fastapi

# Local Python FastAPI Ollama Service (Qwen 2.5 3B)
FASTAPI_AI_URL=http://127.0.0.1:8000/chat

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
